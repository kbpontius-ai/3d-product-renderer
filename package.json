{
  "name": "3d-product-renderer",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "fixtures:artwork": "tsx scripts/make-fixture-artwork.ts",
    "e2e": "playwright test",
    "build:web": "pnpm --filter @pr/web build",
    "bundle:budget": "tsx scripts/bundle-budget.ts",
    "fixtures:meshes": "tsx scripts/make-fixture-meshes.ts",
    "fixtures": "pnpm fixtures:artwork && pnpm fixtures:meshes",
    "db:start": "./scripts/dev-db.sh start",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "seed:dev": "tsx scripts/seed-dev.ts",
    "import:pack": "tsx scripts/import-pack.ts",
    "render:sample": "tsx scripts/render-sample.ts",
    "worker:render": "pnpm --filter @pr/worker-render start",
    "preview:probe": "tsx scripts/preview-probe.ts",
    "grant:staff": "tsx scripts/grant-staff.ts",
    "backup": "./scripts/backup.sh",
    "backup:drill": "tsx scripts/backup-drill.ts",
    "worker:cad": "pnpm --filter @pr/worker-cad start",
    "fixtures:cad": "tsx scripts/make-fixture-cad.ts",
    "check:env": "tsx scripts/check-env-docs.ts",
    "start:web": "pnpm --filter @pr/web exec next start",
    "catalog:thumbnails": "tsx scripts/catalog-thumbnails.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@pr/admin": "workspace:*",
    "@pr/artwork": "workspace:*",
    "@pr/auth": "workspace:*",
    "@pr/cad": "workspace:*",
    "@pr/cad-jobs": "workspace:*",
    "@pr/cad-occt": "workspace:*",
    "@pr/catalog": "workspace:*",
    "@pr/db": "workspace:*",
    "@pr/design-schema": "workspace:*",
    "@pr/gltf": "workspace:*",
    "@pr/job-queue": "workspace:*",
    "@pr/packfile": "workspace:*",
    "@pr/parity": "workspace:*",
    "@pr/raster": "workspace:*",
    "@pr/svg": "workspace:*",
    "@pr/worker-cad": "workspace:*",
    "@types/node": "^22.10.2",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "hash-wasm": "^4.12.0",
    "postgres": "^3.4.9",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "@tailwindcss/oxide",
      "unrs-resolver"
    ]
  }
}
