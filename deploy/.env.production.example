# Production environment for `deploy/compose.yaml`.
#
#   cd deploy && cp .env.production.example .env && $EDITOR .env
#
# `.env` is gitignored; this template is not. Never commit a filled-in copy — four of the values
# below are credentials.
#
# Every variable the application reads is documented in the env table in ../README.md, and
# `pnpm check:env` fails the build if one is added without being written down. This file covers the
# subset compose needs on the server; the rest have defaults baked into the images.

# --- identity and TLS --------------------------------------------------------------------------
# Must already resolve to this droplet before the first `docker compose up`, or Let's Encrypt
# refuses the certificate and Caddy retries into a rate limit.
APP_DOMAIN=renderer.example.com
# Where invitation, reset and render links point. https, and the same host as APP_DOMAIN: the
# session cookie is `__Host-` prefixed and will not be set over plain http off localhost.
APP_URL=https://renderer.example.com
# Let's Encrypt sends expiry warnings here. A real mailbox somebody reads.
ACME_EMAIL=ops@example.com

# --- credentials -------------------------------------------------------------------------------
# Generate each separately: openssl rand -hex 32
POSTGRES_SUPERUSER_PASSWORD=
POSTGRES_APP_PASSWORD=
# Signs per-viewer asset URLs. Changing it invalidates every outstanding image URL, which is
# harmless; losing it and generating a new one on each restart is not, across more than one process.
ASSET_URL_SECRET=

# --- mail (F-PLAT-09) --------------------------------------------------------------------------
# Unset means no mail is sent: invitations, password resets and render notifications are logged and
# go nowhere. Outside development the console does not show invitation links, so without this only
# the first account (made from the server, docs/27-deployment.md) can sign in, and nobody can reset
# a forgotten password.
#
# The API host must be reachable from the droplet. This fails at runtime, not at deploy time: a
# blocked egress rule looks exactly like a working deployment until the first invitation.
RESEND_API_KEY=
# The envelope sender. The domain has to be verified in Resend, and a subdomain is the right choice
# so a bad sending month never touches the apex domain's reputation.
MAIL_FROM=3D Product Renderer <no-reply@mail.example.com>
# Optional. Unset means replies bounce; set it to a mailbox somebody reads.
MAIL_REPLY_TO=

# --- capacity ----------------------------------------------------------------------------------
# Cycles threads per render. Leave headroom for the web app on a shared droplet.
RENDER_THREADS=2

# --- logging ---------------------------------------------------------------------------------
LOG_LEVEL=info
