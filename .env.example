# Copy to .env.local and edit. Nothing here is read automatically — this is a reference you source
# or paste from, because the workers, the CLI scripts and the web app are separate processes and
# only you know which ones you are running.
#
#   cp .env.example .env.local && $EDITOR .env.local
#   set -a && . ./.env.local && set +a
#
# .env.local is gitignored. Never commit a filled-in copy: ASSET_URL_SECRET and DATABASE_URL below
# are credentials.
#
# Every variable the code reads is documented in README.md, and `pnpm check:env` fails the build if
# one is added without being written down.

# --- required for anything beyond the demo route ---------------------------------------------
# Unset means /design/demo only: the editor works, nothing is saved, integration tests skip.
# `./scripts/dev-db.sh start` prints one for a throwaway cluster under .tmp/.
DATABASE_URL=

# Origin used to build invitation and password-reset links. Wrong here means links that 404.
APP_URL=http://localhost:3000

# --- storage -----------------------------------------------------------------------------------
# Uploaded artwork, pack assets and finished renders. The database stores keys relative to this, so
# every process must agree: set it for all of them or for none.
STORAGE_ROOT=

# Signs per-viewer asset URLs. Unset means a new secret each time the process starts, which is fine
# for one machine and breaks images across a fleet. Generate: openssl rand -hex 32
ASSET_URL_SECRET=

# --- mail --------------------------------------------------------------------------------------
# Unset means nothing is delivered: invitations, password resets and render notifications are
# logged and go nowhere. Fine for local work — DEV_TOOLING below gives you an in-memory mailbox at
# /api/dev/mail — and not fine on a server, where it is how an invited person is never told.
RESEND_API_KEY=
# Required alongside the key. The domain must be verified with the provider.
MAIL_FROM=3D Product Renderer <no-reply@mail.example.com>
# Optional. Unset means replies bounce.
MAIL_REPLY_TO=

# --- rendering ---------------------------------------------------------------------------------
# The worker refuses to start without a usable Blender rather than claiming jobs it would fail.
BLENDER_PATH=
# macOS: /Applications/Blender.app/Contents/MacOS/Blender
RENDER_THREADS=
RENDER_SCRATCH=.tmp/render-work
# `fake` exercises the whole queue and download path with no renderer installed.
RENDER_BACKEND=cycles-local

# --- CAD ingestion -----------------------------------------------------------------------------
# Which interpreter has the OCCT bindings (pip install cadquery-ocp==7.9.3.1.1).
CAD_PYTHON=python3
# Unset picks OCCT when present and warns when falling back to the kernel-free stand-in — which
# produces parametric cylinders, not your geometry. `occt` forces the real one and fails loudly.
CAD_IMPORTER=
# `require` on any server: the worker refuses to start rather than parse a stranger's file
# unconfined. Linux only — on macOS the sandbox does not exist and `prefer` warns and continues.
CAD_SANDBOX=prefer
CAD_SCRATCH=.tmp/cad-work
CAD_THREADS=
CAD_TIMEOUT_SEC=600
CAD_MAX_SOURCE_BYTES=268435456
# Part of the ingestion dedupe key. Bump when the kernel or tessellation parameters change.
CAD_PIPELINE_VERSION=2026.08.1

# --- logging -----------------------------------------------------------------------------------
LOG_LEVEL=debug
# `json` for machine-readable logs in development; production defaults to JSON lines already.
LOG_FORMAT=

# --- development and tests only ----------------------------------------------------------------
# Turns on the invitation endpoint and the in-memory mailbox. Both gates must be on in a production
# build, which is deliberate: DEV_TOOLING alone does nothing there.
DEV_TOOLING=false
ALLOW_DEV_TOOLING_IN_PRODUCTION=false
# Set to `off` where there is no outbound network. The local strength gate still applies.
PASSWORD_BREACH_CHECK=
E2E_PORT=3100
CHROMIUM_PATH=
# Where scripts/dev-db.sh finds initdb and pg_ctl. macOS: $(brew --prefix postgresql@16)/bin
PG_BIN=
